# Local real-data grid (never commit the real GeoJSON itself).
AGNI_GRID_PATH=data-pipeline/output/real/risk_grid.geojson

# Persistent inspections: server-side only. Never prefix these with NEXT_PUBLIC.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-only-secret-key
AGNI_SCAN_WRITE_TOKEN=replace-with-a-long-random-team-write-token
